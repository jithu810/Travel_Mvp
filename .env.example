# Project Settings > API in Supabase. Use a public key, never a service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for projects using the legacy anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public pk. token from Mapbox. Restrict it to your development/deployment URLs.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Public production HTTPS origin, without a path (not localhost or the LAN IP).
# Required for canonical URLs, sitemap, social previews, and indexing.
NEXT_PUBLIC_SITE_URL=
